    <item>
      <title>Competenza nelle Soluzioni Personalizzate di Forgiatura dell&#39;Alluminio per Diversi Settori</title>
      <link>https://mis3085.github.io/docs-aft-forge/it/product/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://mis3085.github.io/docs-aft-forge/it/product/</guid>
      <description>&lt;h2 class=&#34;relative group&#34;&gt;Competenza nelle Soluzioni Personalizzate di Forgiatura dell&amp;rsquo;Alluminio per Diversi Settori 
    &lt;div id=&#34;competenza-nelle-soluzioni-personalizzate-di-forgiatura-dellalluminio-per-diversi-settori&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700&#34;
